{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivy-control.local/schemas/hermes/decision-packet.schema.json",
  "title": "Hermes Decision Packet",
  "type": "object",
  "required": ["schema_version", "decision_id", "decision_type", "required_authority", "state", "bounded_question", "reason_required", "governing_references", "affected_tasks", "evidence", "options", "recommended_disposition", "safe_default", "required_response_format", "downstream_state_changes"],
  "properties": {
    "schema_version": {"const": "hermes.decision_packet.v1"},
    "decision_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "decision_type": {"type": "string", "minLength": 1},
    "required_authority": {"enum": ["buddy", "gpt", "strong_codex"]},
    "state": {"enum": ["identified", "preparation_required", "preparation_in_progress", "ready_for_review", "under_review", "supplemental_evidence_required", "decided", "deferred", "superseded", "invalidated"]},
    "bounded_question": {"type": "string", "minLength": 1},
    "reason_required": {"type": "string", "minLength": 1},
    "governing_references": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "affected_tasks": {"type": "array", "items": {"type": "string"}},
    "evidence": {"type": "object", "required": ["repository", "runtime", "semantic", "representative_samples", "high_risk_samples", "counterexamples", "uncertainties"], "properties": {"repository": {"type": "array"}, "runtime": {"type": "array"}, "semantic": {"type": "array"}, "representative_samples": {"type": "array"}, "high_risk_samples": {"type": "array"}, "counterexamples": {"type": "array"}, "uncertainties": {"type": "array"}}},
    "options": {"type": "array", "minItems": 1},
    "recommended_disposition": {"type": "object", "required": ["disposition", "basis"]},
    "safe_default": {"type": "string", "minLength": 1},
    "required_response_format": {"type": "string", "minLength": 1},
    "downstream_state_changes": {"type": "array"}
  },
  "additionalProperties": false
}
